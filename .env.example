# Supabase Configuration (Required)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# AI Services (Required for AI features - set in Supabase Edge Function secrets)
# AI_API_KEY=your_openai_api_key
# AI_MODEL=gpt-4o-mini
# AI_PROVIDER=openai

# Video Extraction Limits (Optional - defaults shown)
# MAX_VIDEO_SIZE_MB=100
# MAX_VIDEO_DURATION_SECONDS=300
# MAX_IMAGE_SIZE_MB=10

# Music Integration (Optional - for official Spotify/YouTube Music integration)
# VITE_SPOTIFY_CLIENT_ID=your_spotify_client_id
# VITE_SPOTIFY_REDIRECT_URI=http://localhost:5173/auth/spotify/callback
# VITE_YOUTUBE_API_KEY=your_youtube_data_api_key

# For local development with Supabase CLI
# SUPABASE_DB_URL=postgresql://postgres:password@localhost:54322/postgres

# Edge Function Secrets (set in Supabase Dashboard -> Settings -> Edge Functions)
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# AI_API_KEY=your_openai_api_key
# AI_MODEL=gpt-4o-mini
# AI_PROVIDER=openai